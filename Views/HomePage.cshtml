@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage;
@using System.Linq;
@using System.IO;
@using Umbraco.Cms.Core.Models;
@{
	Layout = null;
}
@{
	var backgroundColor = Model.Value<string>("colorPicker");
	if (backgroundColor != null)
	{
		<body style="background-color: @backgroundColor"></body>
	}
}

<h1>
	@Model.Value(
		"mainHeader",
		fallback: Fallback.ToDefaultValue,
		defaultValue: "this is where the main header text goes")
</h1>

<h3>
	@Model.Value(
		"subHeader",
		fallback: Fallback.ToDefaultValue,
		defaultValue: "this is where the sub header text goes")
</h3>


<div>@(Model.Value<DateTime>("dateAndTime").ToString("dd-MM-yyyy HH:mm:ss"))</div>

<div>
	@{
		if (Model.HasValue("testBox"))
		{
			<ul>
				@foreach (var item in Model.Value<IEnumerable<string>>("testBox"))
				{
					<li>@item</li>
				}
			</ul>
		}
	}
</div>
<div>@(Model.Value<IEnumerable<string>>("testBox")?.FirstOrDefault())</div>

<div style="display: flex; align-items: center;">
	<div style="margin-right: 4px">
		@Model.Value("bodyText")
	</div>
	<div>
		@{
			var myImages = Model.Value<IEnumerable<MediaWithCrops>>("image1");
			if (myImages != null)
			{
				foreach (var item in myImages)
				{
					<img src="@item.MediaUrl()" style="width: 200px" alt=""/>
				}
			}
		}
	</div>
</div>
<div>
	@if (Model.HasValue("fileUploader"))
	{
		var picture = Model.Value<string>("fileUploader");
		<a href="@picture">@System.IO.Path.GetFileName(picture)</a>
	}
</div>

<p>@Model.Value("footerText")</p>